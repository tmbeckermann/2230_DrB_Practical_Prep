{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2230-practical-prep",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
